# ================================================================
# Prithvi Fix — Backend Environment Configuration Example
# ================================================================

PORT=5000
NODE_ENV=development

# PostgreSQL Connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=sahakari_sevasetu

# Or Connection String:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/sahakari_sevasetu

# JWT Secret
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
CORS_ALLOW_ALL=true
